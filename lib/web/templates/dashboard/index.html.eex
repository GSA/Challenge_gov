<section class="content">
  <%= if !Accounts.is_solver?(@current_user) do %>
    <%= recertification_warning(@conn, @current_user)%>
  <% end %>

  <%= if Accounts.is_evaluator?(@current_user) do %>
    <%= evaluator_notice() %>
  <% end %>
  <main class="grid-container">
  <%= dashboard_header(@current_user) %>
    <div class="col-md-6">
        <div class="flex-justify-center width-full padding-bottom-4">
          <%= dashboard_card_links(@current_user) %>
        </div>
    </div>
  </main>
</section>
